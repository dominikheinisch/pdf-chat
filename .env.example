# Template for .env: cp .env.example .env, then fill in every value.
# .env is gitignored and kept out of the Docker image.

# Claude API key; the app won't start without it.
ANTHROPIC_API_KEY=

# Optional: Claude model for every answer (default claude-haiku-5-5).
# LLM_MODEL=claude-haiku-5-5

# Signs Chainlit's login cookie. Generate one with: openssl rand -hex 32
CHAINLIT_AUTH_SECRET=

# The only account that can log in; saved chats belong to this user.
DEMO_USERNAME=demo
DEMO_PASSWORD=

# Optional: host port for the UI (default 8001).
# APP_PORT=8001
